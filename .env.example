PORT=3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Set your exact public HTTPS origin when deployed.
# APP_ORIGIN=https://chat.example.com
# Production TURN relay (required for reliable calls across mobile/office networks).
# TURN_HOST=turn.example.com
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# Use either a fixed username + credential or a REST-auth shared secret.
# TURN_USERNAME=
# TURN_CREDENTIAL=
# TURN_SECRET=
